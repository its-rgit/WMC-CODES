# SETTINGS
HYSTERESIS_DB = 3.0
PING_PONG_WINDOW_S = 20.0

# CSV DATA
CSV_DATA = """Time_s,ServingCellID,ServingRSRP_dBm,NeighborCellID,NeighborRSRP_dBm
